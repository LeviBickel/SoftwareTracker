<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WF7X616DWL"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-WF7X616DWL');
    </script>

    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- SEO Meta Tags -->
    <title>@ViewData["Title"] - SoftwareTracker | License Management Software</title>
    <meta name="description"
        content="@(ViewData["Description"] ?? "SoftwareTracker - Centralized software license management platform. Track license keys, monitor expiration dates, and manage your software assets efficiently.")" />
    <meta name="keywords"
        content="@(ViewData["Keywords"] ?? "software license management, license tracking, software asset management, license key storage, expiration tracking, IT asset management")" />
    <meta name="author" content="SoftwareTracker" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags (Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - SoftwareTracker" />
    <meta property="og:description"
        content="@(ViewData["Description"] ?? "Centralized software license management platform. Track and manage your software licenses with ease.")" />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <meta property="og:site_name" content="SoftwareTracker" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@ViewData["Title"] - SoftwareTracker" />
    <meta name="twitter:description"
        content="@(ViewData["Description"] ?? "Centralized software license management platform.")" />

    <!-- Canonical URL -->
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />

    <!-- Favicon -->
    <link rel="icon" href="~/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico?v=2" type="image/x-icon" />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SoftwareTracker.styles.css" asp-append-version="true" />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "SoftwareTracker",
        "applicationCategory": "BusinessApplication",
        "description": "Software license management and tracking platform",
        "operatingSystem": "Web-based",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "150"
        }
    }
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm" role="navigation" aria-label="Main navigation">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"
                    aria-label="SoftwareTracker Home">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32" style="margin-right: 0.5rem; vertical-align: text-bottom;">
                        <defs>
                            <linearGradient id="navbar-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#E0E7FF;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                        <!-- Background -->
                        <rect width="32" height="32" rx="6" fill="rgba(255,255,255,0.15)"/>
                        <!-- License document icon -->
                        <rect x="8" y="6" width="16" height="20" rx="2" fill="white" opacity="0.95"/>
                        <!-- Key symbol -->
                        <g transform="translate(10, 9)" fill="url(#navbar-gradient)">
                            <circle cx="3" cy="3" r="2.5"/>
                            <rect x="3" y="2" width="8" height="2" rx="1"/>
                            <rect x="9" y="1" width="1" height="1.5"/>
                            <rect x="10.5" y="1" width="1" height="1.5"/>
                        </g>
                        <!-- Lines representing text -->
                        <rect x="10" y="16" width="12" height="1.5" rx="0.5" fill="white" opacity="0.6"/>
                        <rect x="10" y="19" width="10" height="1.5" rx="0.5" fill="white" opacity="0.5"/>
                        <!-- Checkmark -->
                        <path d="M 13 22 L 14 23 L 17 20" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
                    </svg>
                    SoftwareTracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="License" asp-action="Index"
                                    aria-label="View Licenses">Licenses</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Archival" asp-action="Index"
                                    aria-label="View Archived Licenses">Archived</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrators"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="UserAdministration" asp-action="Index"
                                    aria-label="Manage Users">User Management</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="main-content" class="main-content">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="53ac81ea56de" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
