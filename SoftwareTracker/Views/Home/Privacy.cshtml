@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "SoftwareTracker Privacy Policy - Learn how we collect, use, and protect your personal information and software license data. Last updated March 2024.";
    ViewData["Keywords"] = "privacy policy, data protection, software license privacy, personal information, data security";
}

<div class="container">
<article>
    <h1>Privacy Policy</h1>
    <p class="text-muted">
        <time datetime="2024-03-25">Last Updated: 25 March 2024</time>
    </p>

    <section>
        <p>
            SoftwareTracker is committed to protecting the privacy of our users.
        </p>
        <p>
            This Privacy Policy describes how we collect, use, disclose, and protect information that we collect from visitors to SoftwareTracker.
        </p>
    </section>

    <section>
        <h2>Information We Collect</h2>
        <p>
            We collect personal information that you voluntarily provide to us when you interact with SoftwareTracker. This may include your name, email address, mailing address, phone number, and any other information you choose to provide.
        </p>
    </section>

    <section>
        <h2>How We Use Your Information</h2>
        <p>
            We use the information we collect for various purposes, including:
        </p>
        <ul>
            <li>To provide and maintain SoftwareTracker;</li>
            <li>To improve, personalize, and customize SoftwareTracker;</li>
            <li>To communicate with you, including responding to your inquiries and providing customer support;</li>
            <li>To analyze how users interact with SoftwareTracker and to generate insights that help us improve SoftwareTracker and develop new features;</li>
            <li>To detect, prevent, and address technical issues and security vulnerabilities.</li>
        </ul>
    </section>

    <section>
        <h2>Disclosure of Your Information</h2>
        <p>
            We may disclose your personal information to third parties in the following circumstances:
        </p>
        <ul>
            <li>With your consent;</li>
            <li>To comply with legal obligations or respond to lawful requests from government authorities;</li>
            <li>To protect our rights, property, or safety, or the rights, property, or safety of others.</li>
        </ul>
    </section>

    <section>
        <h2>Data Security</h2>
        <p>
            We take reasonable measures to protect the security of your personal information and to prevent unauthorized access, disclosure, alteration, or destruction. However, please be aware that no method of transmission over the internet or method of electronic storage is 100% secure.
        </p>
    </section>

    <section>
        <h2>Third-Party Links</h2>
        <p>
            SoftwareTracker may contain links to third-party websites or services that are not owned or controlled by us. We are not responsible for the privacy practices or content of such third-party websites or services. We encourage you to review the privacy policies of those third parties before providing any personal information.
        </p>
    </section>

    <section>
        <h2>Changes to This Privacy Policy</h2>
        <p>
            We reserve the right to update or modify this Privacy Policy at any time. If we make material changes to this Privacy Policy, we will notify you by posting the updated Privacy Policy on SoftwareTracker and updating the "Last Updated" date above.
        </p>
    </section>

    <section>
        <h2>Contact Us</h2>
        <p>
            If you have any questions about this Privacy Policy, please contact us through the support channels available in the application.
        </p>
    </section>
</article>
</div>

@section Scripts {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebPage",
        "name": "Privacy Policy - SoftwareTracker",
        "description": "Privacy Policy for SoftwareTracker license management platform",
        "datePublished": "2024-03-25",
        "dateModified": "2024-03-25"
    }
    </script>
}
