@model IEnumerable<SoftwareTracker.Models.LicenseModel>

@{
    ViewData["Title"] = "Licenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
<div class="page-header">
    <h1 class="page-title">Software Licenses</h1>
    <a class="btn btn-primary" asp-action="Create">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 0.5rem;">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Add License
    </a>
</div>

@if (Model.Any())
{
    <div class="license-grid">
        @foreach (var item in Model)
        {
            var isExpiring = item.LicenseExp <= DateTime.Now.AddDays(30);
            var isSupportExpiring = item.Support && item.SupportExp <= DateTime.Now.AddDays(30);
            var cardClass = isExpiring || isSupportExpiring ? "license-card warning" : "license-card";

            <div class="@cardClass">
                <div class="license-card-header">
                    <h3 class="license-title">@item.SoftwareTitle</h3>
                    <div class="license-manufacturer">@item.Manufacturer</div>
                </div>

                <div class="license-card-body">
                    <div class="license-info">
                        <div class="license-info-row">
                            <span class="license-label">Server:</span>
                            <span class="license-value">@item.AssignedServer</span>
                        </div>
                        <div class="license-info-row">
                            <span class="license-label">Purchase Order:</span>
                            <span class="license-value">@item.PurchaseOrder</span>
                        </div>
                        <div class="license-info-row">
                            <span class="license-label">Type:</span>
                            <span class="license-value">@item.LicenseType</span>
                        </div>
                        <div class="license-info-row">
                            <span class="license-label">License Expires:</span>
                            <span class="license-value @(isExpiring ? "text-warning" : "")">
                                @item.LicenseExp.ToShortDateString()
                                @if (isExpiring)
                                {
                                    <span class="badge badge-warning">Expiring Soon</span>
                                }
                            </span>
                        </div>
                        @if (item.Support)
                        {
                            <div class="license-info-row">
                                <span class="license-label">Support Expires:</span>
                                <span class="license-value @(isSupportExpiring ? "text-warning" : "")">
                                    @item.SupportExp?.ToShortDateString()
                                    @if (isSupportExpiring)
                                    {
                                        <span class="badge badge-warning">Expiring Soon</span>
                                    }
                                </span>
                            </div>
                        }
                        <div class="license-info-row">
                            <span class="license-label">Keys:</span>
                            <span class="license-value">
                                @item.UsedKeys / @item.AmountofKeys
                                <span class="text-muted">(@item.RemainingKeys remaining)</span>
                            </span>
                        </div>
                    </div>

                    <div class="license-actions">
                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline">View Details</a>
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline">Edit</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
            <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
        </svg>
        <h2>No Licenses Yet</h2>
        <p>Get started by adding your first software license.</p>
        <a class="btn btn-primary" asp-action="Create">Add Your First License</a>
    </div>
}
</div>
